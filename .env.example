# Crystal Guild v1.1.15 — Wayfarer
# Twitch application credentials
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Numeric Twitch user IDs (not usernames)
TWITCH_BOT_ID=
TWITCH_OWNER_ID=

BOT_PREFIX=!

# Runtime mode: local (default) or cloud.
CRYSTAL_GUILD_RUNTIME_MODE=local

# Local defaults remain unchanged. Render Blueprint overrides persistent paths.
DATABASE_PATH=crystal_guild.db
DATA_DIR=data
LOG_DIR=logs
TWITCH_TOKEN_DB=

# Combat and recovery timing settings
VENTURE_COOLDOWN_SECONDS=600
ENCOUNTER_JOIN_SECONDS=45
ENCOUNTER_ROUND_SECONDS=20
# CAMP_REST_SECONDS is retained for legacy config compatibility; Camp is now 900s LIVE / 3600s OFFLINE before Fellowship reductions.
CAMP_REST_SECONDS=3600
SHOP_REFRESH_SECONDS=1800
RAID_JOIN_SECONDS=60
RAID_ROUND_SECONDS=15
OVERLAY_STATE_PATH=overlay/state.json

# Hosted Web Hub / Portal relay
PORTAL_PUBLIC_URL=
PORTAL_SYNC_KEY=
PORTAL_SYNC_SECONDS=5
PORTAL_SYNC_HEARTBEAT_SECONDS=30
PORTAL_SYNC_TIMEOUT_SECONDS=10
PORTAL_SYNC_VERIFY_TLS=true

# Cloud mode defaults this to true so one Render worker owns Bot + Portal sync.
PORTAL_SYNC_IN_PROCESS=false

# Portal Actions protocol 12
PORTAL_ACTION_POLL_SECONDS=3
PORTAL_ACTION_TIMEOUT_SECONDS=10
PORTAL_ACTION_VERIFY_TLS=true

# Cloud safety: do not silently create an empty Guild on a new disk.
CLOUD_REQUIRE_EXISTING_DATABASE=true
CLOUD_BOOTSTRAP_WAIT_SECONDS=30

# Twitch live-stream gate (optional tuning; existing Twitch credentials are reused)
STREAM_STATUS_CACHE_SECONDS=15
STREAM_STATUS_STALE_SECONDS=90

# Twitch subscriber-tier lookup (optional tuning).
# Requires broadcaster OAuth scope: channel:read:subscriptions
SUBSCRIPTION_STATUS_CACHE_SECONDS=300
SUBSCRIPTION_STATUS_STALE_SECONDS=900
